# Tezcatlipoca v2 — Environment Variables
# Copy to .env and fill with production values

# Backend API Base URL
VITE_API_BASE=http://localhost:8000/api/v1

# WebSocket endpoint for live data
VITE_WS_URL=ws://localhost:8000/ws

# Cesium Ion token (optional, for terrain)
VITE_CESIUM_ION_TOKEN=

# MapLibre style URL
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json

# Feature flags
VITE_ENABLE_LIVE_STREAMING=true
VITE_ENABLE_BIM_4D=true
VITE_ENABLE_BIM_5D=true
